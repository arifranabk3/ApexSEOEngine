# ==============================================================================
# AI SEO AUTOMATION SYSTEM — PHASE 01 ENVIRONMENT CONFIGURATION
# ==============================================================================

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/seo_automation?schema=public&sslmode=disable&connection_limit=1"

# Security & Session Secrets (MUST BE CHANGED IN PRODUCTION)
# 64-hex-character (32-byte) key for AES-256-GCM server-side credential encryption
ENCRYPTION_SECRET="8f4b2e9a1c7d3f6e5a0b4c8d2e6f1a3b9c5d7e0f2a4b6c8d1e3f5a7b9c0d2e4f"
# Secret used to sign HTTP-only JWT sessions
JWT_SECRET="super-secret-jwt-signing-key-phase-01-seo-automation-platform-2026"

# Application Configuration
NEXT_PUBLIC_APP_NAME="ApexSEO Autonomous Engine"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Local AI Provider Defaults (Zero-Cost Policy)
DEFAULT_OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_OLLAMA_MODEL="llama3.2:latest"

# Self-Hosted n8n Community Edition Defaults
N8N_BASE_URL="http://localhost:5678"
N8N_WEBHOOK_BASE_URL="http://localhost:5678/webhook"

# Vercel-First & Standalone Automation Worker Configuration
# Shared HMAC-SHA256 secret between Vercel Functions (/api/v1/jobs) and the standalone worker
WORKER_SHARED_SECRET="8f4b2e9a1c7d3f6e5a0b4c8d2e6f1a3b9c5d7e0f2a4b6c8d1e3f5a7b9c0d2e4f"
# Vercel Cron Bearer token for /api/v1/cron/enqueue-schedules
CRON_SECRET="vercel-cron-secret-phase01-2026"
# Standalone Automation Worker ID & Polling Interval
WORKER_ID="standalone-worker-01"
WORKER_POLL_INTERVAL_MS="10000"
WORKER_PORT="4100"

